{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@frontend-frame/app-kit": ["../app-kit/src/index.ts"],
			"@frontend-frame/app-kit/*": ["../app-kit/src/*"],
			"@frontend-frame/ui": ["../ui/src/index.ts"],
			"@frontend-frame/ui/*": ["../ui/src/*"]
		},
		"types": ["node", "vite/client"]
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"]
}
