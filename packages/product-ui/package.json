{
	"name": "@frontend-frame/product-ui",
	"version": "0.1.0",
	"description": "Data-driven product UI mockups for marketing and demo surfaces",
	"license": "UNLICENSED",
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./pipeline-forecast": {
			"development": "./src/mockups/pipeline-forecast.tsx",
			"types": "./dist/mockups/pipeline-forecast.d.ts",
			"import": "./dist/pipeline-forecast.js"
		},
		"./contact-enrichment": {
			"development": "./src/mockups/contact-enrichment.tsx",
			"types": "./dist/mockups/contact-enrichment.d.ts",
			"import": "./dist/contact-enrichment.js"
		},
		"./workflow-automation": {
			"development": "./src/mockups/workflow-automation.tsx",
			"types": "./dist/mockups/workflow-automation.d.ts",
			"import": "./dist/workflow-automation.js"
		},
		"./feature-frame": {
			"development": "./src/mockups/feature-frame.tsx",
			"types": "./dist/mockups/feature-frame.d.ts",
			"import": "./dist/feature-frame.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "rm -rf dist && vite build && tsc -p tsconfig.build.json",
		"dev": "vite build --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@frontend-frame/ui": "workspace:*",
		"lucide-react": "^0.548.0",
		"motion": "^12.23.24"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@frontend-frame/build-config": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"vite": "^7.3.7"
	}
}
