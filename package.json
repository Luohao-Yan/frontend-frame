{
	"name": "frontend-frame",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"packageManager": "pnpm@11.28.5",
	"scripts": {
		"dev": "pnpm --filter @frontend-frame/demo dev",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck && pnpm typecheck:visual",
		"typecheck:visual": "tsc -p tsconfig.visual.json --noEmit",
		"preview": "pnpm --filter @frontend-frame/demo preview",
		"format": "prettier --write .",
		"lint": "eslint . --max-warnings 0",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^24.10.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"prettier": "^3.6.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
